{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cmetech/oscar-corrtest/docs/schema/correlation-scenario.schema.json",
  "title": "OSCAR Correlation Scenario",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "name",
    "suite",
    "pattern",
    "maxDuration",
    "cases"
  ],
  "properties": {
    "apiVersion": {
      "const": "corrtest.oscar/v1alpha1"
    },
    "cases": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/case"
      },
      "allOf": [
        {
          "contains": {
            "allOf": [
              {
                "required": [
                  "code"
                ],
                "properties": {
                  "code": {
                    "const": "P01"
                  }
                }
              },
              {
                "required": [
                  "polarity"
                ],
                "properties": {
                  "polarity": {
                    "const": "positive"
                  }
                }
              }
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "allOf": [
              {
                "required": [
                  "code"
                ],
                "properties": {
                  "code": {
                    "const": "N01"
                  }
                }
              },
              {
                "required": [
                  "polarity"
                ],
                "properties": {
                  "polarity": {
                    "const": "negative"
                  }
                }
              }
            ]
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    },
    "kind": {
      "const": "CorrelationScenario"
    },
    "maxDuration": {
      "type": "string",
      "minLength": 1,
      "x-corrtest-format": "go-duration",
      "x-corrtest-minimum": "\u003e 0",
      "x-corrtest-maximum": "5m0s"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^\\S(?:.*\\S)?$"
    },
    "pattern": {
      "enum": [
        "flood",
        "co_occurrence",
        "sequence",
        "persistence",
        "absence",
        "parent_child",
        "cross_source",
        "threshold"
      ]
    },
    "suite": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^\\S(?:.*\\S)?$"
    }
  },
  "$defs": {
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "equals"
      ],
      "properties": {
        "equals": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "kind": {
          "enum": [
            "synthetic-alert-count",
            "audit-count",
            "parent-link-count"
          ]
        },
        "outcome": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^\\S(?:.*\\S)?$"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "const": "synthetic-alert-count"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "outcome"
              ]
            }
          }
        },
        {
          "if": {
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "audit-count",
                  "parent-link-count"
                ]
              }
            }
          },
          "then": {
            "required": [
              "outcome"
            ]
          }
        }
      ]
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "code",
        "polarity",
        "window",
        "assertions"
      ],
      "properties": {
        "assertions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/assertion"
          }
        },
        "code": {
          "enum": [
            "P01",
            "N01"
          ]
        },
        "events": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/event"
          }
        },
        "groupBy": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          }
        },
        "labels": {
          "type": "object",
          "maxProperties": 64,
          "additionalProperties": {
            "type": "string",
            "maxLength": 500,
            "pattern": "^[^\\r\\n\\u0000]*$"
          },
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          }
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "polarity": {
          "enum": [
            "positive",
            "negative"
          ]
        },
        "repeat": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "suppressForNotifiers": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^\\S(?:.*\\S)?$"
          }
        },
        "tagForNotifiers": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^\\S(?:.*\\S)?$"
          }
        },
        "window": {
          "type": "string",
          "minLength": 1,
          "x-corrtest-format": "go-duration",
          "x-corrtest-minimum": "\u003e 0",
          "x-corrtest-maximum": "2m0s"
        }
      },
      "oneOf": [
        {
          "required": [
            "role",
            "repeat"
          ],
          "not": {
            "required": [
              "events"
            ]
          }
        },
        {
          "required": [
            "events"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "role"
                ]
              },
              {
                "required": [
                  "repeat"
                ]
              }
            ]
          }
        }
      ]
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "status"
      ],
      "properties": {
        "delay": {
          "type": "string",
          "minLength": 1,
          "x-corrtest-format": "go-duration",
          "x-corrtest-minimum": "\u003e= 0",
          "x-corrtest-maximum": "scenario and observation budgets"
        },
        "labels": {
          "type": "object",
          "maxProperties": 64,
          "additionalProperties": {
            "type": "string",
            "maxLength": 500,
            "pattern": "^[^\\r\\n\\u0000]*$"
          },
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          }
        },
        "role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "status": {
          "enum": [
            "firing",
            "resolved"
          ]
        }
      }
    }
  }
}
