{{define "authoring"}}
{{$page := .Authoring}}
<section class="page-heading authoring-heading">
  <p class="eyebrow">Target-free engineering guide</p>
  <h1>Scenario Authoring</h1>
  <p>Assemble a closed CorrTest scenario from the public contract, inspect its deterministic preview, then open the canonical example in the editor.</p>
</section>

<section class="authoring-workspace" aria-label="Scenario authoring workspace">
  <aside class="authoring-outline">
    <header><p class="eyebrow">Guide outline</p><h2>Build surface</h2></header>
    <nav aria-label="Authoring sections">
      {{range $page.Catalog.Sections}}{{if eq .ID "quickstart"}}<a href="/authoring?section=quickstart&amp;step=identity&amp;pattern=flood&amp;level=basic&amp;view=yaml#quickstart"{{if eq .ID $page.Selection.Section}} aria-current="page"{{end}}><strong>{{.Title}}</strong><small>{{.Summary}}</small></a>{{else}}<a href="/authoring?section={{urlquery .ID}}&amp;step={{urlquery $page.Selection.Step}}&amp;pattern={{urlquery $page.Selection.Pattern}}&amp;level={{urlquery $page.Selection.Level}}&amp;view={{urlquery $page.Selection.View}}#{{.ID}}"{{if eq .ID $page.Selection.Section}} aria-current="page"{{end}}><strong>{{.Title}}</strong><small>{{.Summary}}</small></a>{{end}}{{end}}
    </nav>
    <section class="authoring-outline__steps" aria-labelledby="authoring-steps-title">
      <p class="eyebrow" id="authoring-steps-title">Quickstart steps</p>
      <ol>
        {{range $page.Catalog.Lessons}}<li><a href="/authoring?section=quickstart&amp;step={{urlquery .ID}}&amp;pattern=flood&amp;level=basic&amp;view=yaml#step-{{.ID}}"{{if and (eq $page.Selection.Section "quickstart") (eq .ID $page.Selection.Step)}} aria-current="step"{{end}}>{{.Title}}</a></li>{{end}}
      </ol>
    </section>
  </aside>

  <div class="authoring-content">
    {{template "authoring-quickstart" .}}
    {{template "authoring-schema" .}}
    {{template "authoring-pattern" .}}
  </div>
  {{template "authoring-preview" .}}
</section>
{{end}}
