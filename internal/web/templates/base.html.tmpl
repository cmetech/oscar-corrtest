{{define "base"}}<!doctype html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>OSCAR Correlation Test Harness</title>
  <script nonce="{{.Nonce}}">(function(){try{var k='corrtest-theme';var s=localStorage.getItem(k);var t=(s==='light'||s==='dark')?s:(matchMedia('(prefers-color-scheme: light)').matches?'light':'dark');document.documentElement.dataset.theme=t;document.documentElement.style.colorScheme=t;}catch(e){document.documentElement.dataset.theme='dark';}})();</script>
  <link rel="stylesheet" href="/static/css/tokens.css">
  <link rel="stylesheet" href="/static/css/base.css">
  <link rel="stylesheet" href="/static/css/components.css">
  <link rel="stylesheet" href="/static/css/pages.css">
  <script defer src="/static/js/theme.js"></script>
  <script defer src="/static/js/run-stream.js"></script>
  <script defer src="/static/js/help.js"></script>
  <script defer src="/static/js/scenarios.js"></script>
  <script defer src="/static/js/operations.js"></script>
</head>
<body>
  <header class="app-header">
    <div class="brand-lockup">
      <span class="brand-mark" aria-hidden="true">OC</span>
      <a class="brand" href="/" aria-label="OSCAR Correlation Test Harness home">OSCAR <span>Correlation Test Harness</span></a>
    </div>
    <div class="header-tools">
      <span class="build">{{.Version.Version}} · {{.Version.Commit}}</span>
      <button class="reference-button" type="button" data-help-open aria-controls="page-help-drawer" aria-expanded="false">? Page reference</button>
      <button class="theme-toggle" type="button" data-theme-toggle aria-label="Light theme" aria-pressed="false" title="Switch to light theme">
        <span class="theme-toggle__icon" data-theme-icon aria-hidden="true">☾</span>
      </button>
    </div>
  </header>
  <div class="app-shell">
    <nav class="primary-nav" aria-label="Primary">
      <a href="/"{{if eq .Page "dashboard"}} aria-current="page"{{end}}>Dashboard</a>
	  <a href="/run-test"{{if eq .Page "run-test"}} aria-current="page"{{end}}>Run test</a>
      <a href="/runs"{{if or (eq .Page "runs") (eq .Page "run-detail")}} aria-current="page"{{end}}>Runs</a>
      <a href="/scenarios"{{if eq .Page "scenarios"}} aria-current="page"{{end}}>Scenarios</a>
      <a href="/targets"{{if eq .Page "targets"}} aria-current="page"{{end}}>Targets</a>
      <a href="/operations"{{if eq .Page "operations"}} aria-current="page"{{end}}>Operations</a>
      <a href="/reference"{{if eq .Page "reference"}} aria-current="page"{{end}}>Reference</a>
    </nav>
    <main>
      {{if eq .Page "targets"}}{{template "targets" .}}
	  {{else if eq .Page "run-test"}}{{template "run-test" .}}
      {{else if eq .Page "scenarios"}}{{template "scenarios" .}}
      {{else if eq .Page "runs"}}{{template "runs" .}}
      {{else if eq .Page "run-detail"}}{{template "run-detail" .}}
      {{else if eq .Page "operations"}}{{template "operations" .}}
      {{else if eq .Page "reference"}}{{template "reference" .}}
      {{else}}{{template "dashboard" .}}{{end}}
    </main>
  </div>
  {{template "help-drawer" .}}
</body>
</html>{{end}}
